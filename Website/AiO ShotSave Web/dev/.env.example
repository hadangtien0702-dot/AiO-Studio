# Chép file này thành .env (cùng thư mục) rồi điền. .env KHÔNG lên git.
# GMAIL_USER = địa chỉ Gmail dùng để GỬI thư thử
# GMAIL_APP_PASSWORD = "Mật khẩu ứng dụng" 16 ký tự (không phải mật khẩu Gmail thường)
#   Tạo ở https://myaccount.google.com/apppasswords (tài khoản phải bật xác minh 2 bước)
GMAIL_USER=
GMAIL_APP_PASSWORD=
PORT=3000
