<?xml version="1.0" encoding="UTF-8"?>
<!--
  Remote debug cho CEP panel Autocut.
  Cong 8089 (AiO Editing dang dung 8088 — hai panel phai khac cong).
  Mo http://localhost:8089 de xem DevTools cua panel dang chay trong Premiere.
-->
<ExtensionList>
  <Extension Id="com.aiostudio.transcript.panel">
    <HostList>
      <Host Name="PPRO" Port="8091" />
    </HostList>
  </Extension>
</ExtensionList>
