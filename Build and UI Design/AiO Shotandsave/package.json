{
  "name": "aio-shot-and-save",
  "productName": "AiO Shot & Save",
  "version": "0.3.11",
  "description": "AiO Shot & Save — chup vung chon + ghim noi (sticky) len man hinh, cho he thong AiO Studio.",
  "author": "AiO Studio",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aiostudio.shotandsave",
    "productName": "AiO Shot & Save",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AiO-Shot-and-Save-Setup-${version}.exe",
      "shortcutName": "AiO Shot & Save",
      "runAfterFinish": true
    }
  }
}
