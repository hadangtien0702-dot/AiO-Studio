  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aiostudio.shotandsave",
    "productName": "AiO Shot & Save",
    "compression": "maximum",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/tesseract.js-core/*-lstm.{js,wasm}"
    ],
    "asarUnpack": [
      "node_modules/**",
      "assets/ocr/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AiO-Shot-and-Save-Setup-${version}.exe",
      "shortcutName": "AiO Shot & Save",
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "AiO-Shot-and-Save-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "AiO Shot & Save can chup man hinh de ban chon vung va ghim anh.",
        "NSMicrophoneUsageDescription": "AiO Shot & Save can micro de thu giong noi cua ban vao video quay man hinh."
      }
    },
    "dmg": {
      "artifactName": "AiO-Shot-and-Save-${version}-mac-${arch}.dmg"
    },
    "protocols": [{ "name": "AiO Shot and Save", "schemes": ["aioshot"] }],
    "afterSign": "scripts/afterSign.js"
  },
  "dependencies": {
    "tesseract.js": "5.1.1"
  }
}
